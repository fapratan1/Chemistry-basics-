                correct: 'A',
                explain: '<b>เฉลย ข้อ ก.</b> ฟอสโฟลิพิดมีโครงสร้างแบบ Amphipathic โดยมี <b>หมู่ฟอสเฟตที่มีขั้ว</b> อยู่ตรงส่วนหัว (Hydrophilic head) และมี <b>กรดไขมัน (หมู่คาร์บอกซิลต่อสายไฮโดรคาร์บอน)</b> ที่ไม่มีขั้วอยู่ตรงส่วนหาง (Hydrophobic tail)'
            }
        };

        function evaluateQuiz(event) {
            event.preventDefault();

            const form = document.getElementById('quizForm');
            let score = 0;

            ['q1', 'q2', 'q3'].forEach(qKey => {
                const selected = form.elements[qKey].value;
                const feedbackEl = document.getElementById(`feedback-${qKey}`);
                const isCorrect = selected === quizAnswers[qKey].correct;

                feedbackEl.classList.remove('hidden', 'bg-emerald-100', 'text-emerald-950', 'border-emerald-300', 'bg-rose-100', 'text-rose-950', 'border-rose-300');

                if (isCorrect) {
                    score++;
                    feedbackEl.classList.add('bg-emerald-100', 'text-emerald-950', 'border-2', 'border-emerald-300');
                    feedbackEl.innerHTML = `<div class="font-bold text-emerald-800 flex items-center mb-1"><i class="fa-solid fa-circle-check mr-2"></i> ถูกต้องแล้วครับ!</div>${quizAnswers[qKey].explain}`;
                } else {
                    feedbackEl.classList.add('bg-rose-100', 'text-rose-950', 'border-2', 'border-rose-300');
                    feedbackEl.innerHTML = `<div class="font-bold text-rose-800 flex items-center mb-1"><i class="fa-solid fa-circle-xmark mr-2"></i> ยังไม่ถูกต้อง</div>${quizAnswers[qKey].explain}`;
                }
            });

            const banner = document.getElementById('quizResultBanner');
            const scoreDisplay = document.getElementById('scoreDisplay');
            const message = document.getElementById('scoreMessage');

            scoreDisplay.innerText = score;
            banner.classList.remove('hidden');

            if (score === 3) {
                message.innerText = "ยอดเยี่ยมที่สุดเลยครับ! น้องๆ มีความเข้าใจเรื่องหมู่ฟังก์ชันเป็นอย่างดี 🎉⭐";
                confetti({ particleCount: 120, spread: 80, origin: { y: 0.6 } });
            } else if (score === 2) {
                message.innerText = "เก่งมากเลยครับ! ลองทบทวนข้อที่ผิดเพิ่มเติมอีกนิดเดียวก็จะเต็มแล้วครับ 👍";
            } else {
                message.innerText = "ลองกลับไปสำรวจโมเดล 3D และการทดลองเสมือนดูอีกครั้งนะครับ ✌️✨";
            }

            banner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        window.onload = function () {
            initThreeJS();
            renderGroupButtons();
            selectFunctionalGroup('hydroxyl');
        };
